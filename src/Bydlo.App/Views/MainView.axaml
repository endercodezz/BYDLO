<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Bydlo.App.Controls"
             xmlns:vm="using:Bydlo.App.ViewModels"
             xmlns:l="using:Bydlo.App.Services"
             xmlns:v="using:Bydlo.App.Views"
             x:Class="Bydlo.App.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="{DynamicResource BackdropBrush}">
  <Grid RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="Auto,*" ClipToBounds="True">
    <!-- Persistent release notice has its own row, including during onboarding. -->
    <Border Grid.ColumnSpan="2" Classes="banner" IsVisible="{Binding HasReleaseNotification}" Margin="12,8">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding ReleaseNotificationText}" FontWeight="SemiBold" TextWrapping="Wrap" />
        <WrapPanel>
          <Button Classes="primary" Content="{l:T update.notification.open}" Command="{Binding OpenReleaseNotificationCommand}" Margin="0,0,8,0" />
          <Button Classes="ghost" Content="{l:T update.notification.dismiss}" Command="{Binding DismissReleaseNotificationCommand}" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <Grid Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="2" RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,*">
    <!-- Desktop sidebar -->
    <Border Grid.RowSpan="3" Width="192" IsVisible="{Binding !IsCompact}"
            Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,26,12,20">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="10,0,6,28">
          <Image Source="{StaticResource BrandLogo}" Width="34" Height="34" VerticalAlignment="Center" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="BYDLO" FontWeight="SemiBold" FontSize="18" LetterSpacing="0.3" />
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="8">
          <Border Classes="pill warn" IsVisible="{Binding IsMock}" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:OutlineIcon Data="{StaticResource LineFlask}" Width="12" Height="12" Foreground="{DynamicResource WarningBrush}" />
              <TextBlock Text="{l:T mock.badge}" />
            </StackPanel>
          </Border>
          <TextBlock Classes="faint" Text="v0.1.0 · GPL-3.0" Margin="4,0" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding PrimaryNavItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <RadioButton Classes="nav" GroupName="nav" Margin="0,0,0,4"
                           IsChecked="{Binding IsSelected, Mode=OneWay}"
                           Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).NavigateCommand}"
                           CommandParameter="{Binding Key}" AutomationProperties.Name="{Binding Title}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <c:OutlineIcon Data="{Binding IconKey, Converter={x:Static l:IconConverter.Instance}}" />
                  <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                </StackPanel>
              </RadioButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <!-- Compact header -->
    <Grid Grid.Column="1" IsVisible="{Binding IsCompact}" ColumnDefinitions="Auto,*,Auto" Margin="16,14,16,0">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Image Source="{StaticResource BrandLogo}" Width="28" Height="28" VerticalAlignment="Center" />
        <TextBlock Text="BYDLO" FontWeight="Bold" FontSize="16" LetterSpacing="0" VerticalAlignment="Center" />
      </StackPanel>
      <Border Grid.Column="2" Classes="pill warn" IsVisible="{Binding IsMock}">
        <TextBlock Text="{l:T mock.badge}" />
      </Border>
    </Grid>

    <!-- Content -->
    <DockPanel Grid.Row="1" Grid.Column="1">
      <Border DockPanel.Dock="Top" IsVisible="{Binding IsSettingsDetail}" Padding="24,12,24,0">
        <Button Classes="ghost" Content="{l:T nav.settings.back}" Command="{Binding NavigateCommand}" CommandParameter="settings" />
      </Border>
      <ContentControl Content="{Binding CurrentPage}" />
    </DockPanel>

    <!-- Compact bottom navigation -->
    <Border Grid.Row="2" Grid.Column="1" IsVisible="{Binding IsCompact}"
            Margin="0"
            Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="4,6">
      <ItemsControl ItemsSource="{Binding PrimaryNavItems}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:NavItem">
            <RadioButton Classes="nav navbottom" GroupName="bottomnav" HorizontalContentAlignment="Center"
                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                         Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).NavigateCommand}"
                         CommandParameter="{Binding Key}" AutomationProperties.Name="{Binding Title}">
              <StackPanel Spacing="3" HorizontalAlignment="Center">
                <c:OutlineIcon Data="{Binding IconKey, Converter={x:Static l:IconConverter.Instance}}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding ShortTitle}" FontSize="10" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </RadioButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- Orphan engines banner -->
    <Border Grid.Row="1" Grid.Column="1" Classes="banner" IsVisible="{Binding HasOrphans}"
            VerticalAlignment="Top" HorizontalAlignment="Center" Margin="16,12">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <c:OutlineIcon Data="{StaticResource LineAlert}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{l:T orphans.text}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
        <Button Classes="ghost" Content="{l:T orphans.stop}" Command="{Binding CleanupOrphansCommand}" />
      </StackPanel>
    </Border>

    <!-- Toast -->
    <Border Grid.Row="1" Grid.Column="1" IsVisible="{Binding HasVisibleToast}"
            VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,22" MaxWidth="560"
            CornerRadius="8" Padding="16,11"
            Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <c:OutlineIcon Data="{StaticResource LineAlert}" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding ToastIsError}" Width="16" Height="16" />
        <c:OutlineIcon Data="{StaticResource LineInfo}" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding !ToastIsError}" Width="16" Height="16" />
        <TextBlock Text="{Binding Toast}" TextWrapping="Wrap" MaxWidth="500" />
      </StackPanel>
    </Border>
    <Border Grid.Row="1" Grid.Column="1" Classes="banner" VerticalAlignment="Top" Margin="16,12"
            IsVisible="{Binding ClipboardOffer, Converter={x:Static ObjectConverters.IsNotNull}}">
      <StackPanel Spacing="10">
        <TextBlock Text="{Binding ClipboardOffer}" TextWrapping="Wrap" />
        <WrapPanel>
          <Button Classes="primary" Content="{l:T import.preview}" Command="{Binding AcceptClipboardOfferCommand}" Margin="0,0,8,0" />
          <Button Classes="ghost" Content="{l:T import.dismiss}" Command="{Binding DismissClipboardOfferCommand}" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <Border Grid.RowSpan="3" Grid.ColumnSpan="2" Margin="8" CornerRadius="12" Padding="24"
            IsVisible="{Binding IsDragOver}" IsHitTestVisible="False" BorderThickness="3"
            BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource Surface2Brush}" Opacity="0.94">
      <TextBlock Text="{l:T import.drop}" FontSize="24" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>
    <Border Grid.RowSpan="3" Grid.ColumnSpan="2" Background="{DynamicResource BackdropBrush}" IsVisible="{Binding HasImportPreview}">
      <Border Classes="panel" MaxWidth="620" Margin="24" VerticalAlignment="Center" MaxHeight="650">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Classes="h2" Text="{l:T import.preview}" Margin="0,0,0,16" />
          <ScrollViewer Grid.Row="1" MaxHeight="420">
            <ItemsControl ItemsSource="{Binding ImportPreviewItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4" /></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <WrapPanel Grid.Row="2" Margin="0,16,0,0" IsEnabled="{Binding !IsImportBusy}">
            <Button Classes="primary" Content="{l:T import.add}" Command="{Binding ConfirmImportCommand}" IsEnabled="{Binding CanConfirmImport}" Margin="0,0,8,0" />
            <Button Classes="ghost" Content="{l:T import.dismiss}" Command="{Binding CancelImportCommand}" />
          </WrapPanel>
        </Grid>
      </Border>
    </Border>

    <Border Grid.RowSpan="3" Grid.ColumnSpan="2" IsVisible="{Binding IsAddServerOpen}" Background="{DynamicResource BackdropBrush}">
      <v:AddServerWizardView DataContext="{Binding AddServerWizard}" />
    </Border>

    <Border Grid.RowSpan="3" Grid.ColumnSpan="2" IsVisible="{Binding IsChainEditorOpen}" Background="{DynamicResource BackdropBrush}">
      <v:ChainEditorView DataContext="{Binding ChainEditor}" />
    </Border>

    <!-- First-run onboarding -->
    <Border Grid.RowSpan="3" Grid.ColumnSpan="2" IsVisible="{Binding IsOnboardingVisible}" Background="{DynamicResource ScrimBrush}">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Center">
        <Border Classes="panel" MaxWidth="560" Margin="24" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource BgBrush}">
          <StackPanel Spacing="16">
            <Border Width="56" Height="56" CornerRadius="18" Background="{DynamicResource PrimaryBrush}">
              <c:OutlineIcon Data="{StaticResource LineShield}" Foreground="{DynamicResource OnPrimaryBrush}" Width="28" Height="28" />
            </Border>
            <TextBlock Classes="h1" Text="{l:T onboarding.title}" TextWrapping="Wrap" />
            <TextBlock Classes="muted" Text="{l:T onboarding.text}" TextWrapping="Wrap" />
            <WrapPanel HorizontalAlignment="Left">
              <Button Classes="primary" Content="{l:T onboarding.start}" Command="{Binding StartOnboardingImportCommand}" Margin="0,0,8,8" />
              <Button Classes="ghost" Content="{l:T onboarding.skip}" Command="{Binding FinishOnboardingCommand}" Margin="0,0,0,8" />
            </WrapPanel>
            <Expander Header="{l:T onboarding.appearance}" HorizontalAlignment="Stretch">
              <StackPanel Spacing="10">
                <TextBlock Classes="caps" Text="{l:T settings.language}" />
                <ComboBox ItemsSource="{x:Static vm:MainViewModel.OnboardingLanguages}" SelectedItem="{Binding OnboardingLanguage}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Text="{Binding Converter={x:Static l:PrefixLocConverter.Instance}, ConverterParameter=lang.}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="caps" Text="{l:T settings.theme}" />
                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="12" Padding="4" HorizontalAlignment="Left">
                  <WrapPanel>
                    <RadioButton Classes="segment" GroupName="onboarding-theme" IsChecked="{Binding OnboardingThemeLight}"><TextBlock Text="{l:T theme.light}" /></RadioButton>
                    <RadioButton Classes="segment" GroupName="onboarding-theme" IsChecked="{Binding OnboardingThemeOled}"><TextBlock Text="{l:T theme.oled}" /></RadioButton>
                    <RadioButton Classes="segment" GroupName="onboarding-theme" IsChecked="{Binding OnboardingThemeSystem}"><TextBlock Text="{l:T theme.system}" /></RadioButton>
                  </WrapPanel>
                </Border>
                <Expander Header="{l:T theme.custom.title}" HorizontalAlignment="Stretch" IsExpanded="{Binding OnboardingThemePurple, Mode=OneWay}">
                    <RadioButton Classes="segment" GroupName="onboarding-theme" IsChecked="{Binding OnboardingThemePurple}"><TextBlock Text="{l:T theme.purple}" /></RadioButton>
                </Expander>
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Border>
    </Grid>
  </Grid>
</UserControl>
