<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:v="using:Bydlo.App.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Bydlo.App.Controls"
             xmlns:vm="using:Bydlo.App.ViewModels"
             xmlns:m="using:Bydlo.Core.Models"
             xmlns:l="using:Bydlo.App.Services"
             x:Class="Bydlo.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <ScrollViewer>
    <StackPanel MaxWidth="880" Margin="24,32,24,32" Spacing="24">
      <TextBlock Classes="h1" Text="{l:T nav.settings}" />

      <Border Classes="panel">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="{l:T settings.network.sections}" />
          <WrapPanel>
            <Button Classes="ghost" Content="{l:T nav.routing}" Command="{Binding Shell.NavigateCommand}" CommandParameter="routing" Margin="0,0,8,8" />
            <Button Classes="ghost" Content="{l:T nav.statistics}" Command="{Binding Shell.NavigateCommand}" CommandParameter="statistics" Margin="0,0,0,8" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- Appearance -->
      <Border Classes="panel">
        <StackPanel Spacing="14">
          <TextBlock Classes="h2" Text="{l:T settings.appearance}" />
          <TextBlock Classes="caps" Text="{l:T settings.theme}" />
          <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="4" HorizontalAlignment="Left">
            <WrapPanel>
              <RadioButton Classes="segment" GroupName="theme" IsChecked="{Binding ThemeLight}"><TextBlock Text="{l:T theme.light}" /></RadioButton>
              <RadioButton Classes="segment" GroupName="theme" IsChecked="{Binding ThemeOled}"><TextBlock Text="{l:T theme.oled}" /></RadioButton>
              <RadioButton Classes="segment" GroupName="theme" IsChecked="{Binding ThemeSystem}"><TextBlock Text="{l:T theme.system}" /></RadioButton>
            </WrapPanel>
          </Border>
          <TextBlock Classes="caps" Text="{l:T settings.language}" />
          <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.Languages}" SelectedItem="{Binding Language}" MinWidth="220">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding Converter={x:Static l:PrefixLocConverter.Instance}, ConverterParameter=lang.}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Classes="ghost" Content="{l:T theme.custom.gallery}" Command="{Binding FetchGalleryCommand}"
                  IsEnabled="{Binding !CustomThemesBusy}" HorizontalAlignment="Left" />
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding CustomThemesBusy}" />
          <ItemsControl ItemsSource="{Binding GalleryThemes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GalleryThemeRow">
                <Border Classes="tile" Margin="0,0,0,6">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="Medium" TextWrapping="Wrap" />
                      <TextBlock Classes="faint" Text="{Binding Author}" />
                    </StackPanel>
                    <Button Grid.Column="1" Classes="primary" Margin="8,0,0,0" VerticalAlignment="Center"
                            Content="{l:T theme.custom.install}" Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).InstallGalleryThemeCommand}" CommandParameter="{Binding Id}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Expander Header="{l:T theme.custom.title}" HorizontalAlignment="Stretch" IsExpanded="{Binding IsUserThemeSelected, Mode=OneWay}">
            <StackPanel Spacing="10">
              <RadioButton Classes="segment" GroupName="theme" IsChecked="{Binding ThemePurple}"><TextBlock Text="{l:T theme.purple}" /></RadioButton>
              <TextBlock Classes="muted" Text="{l:T theme.custom.hint}" TextWrapping="Wrap" />
              <Border Classes="banner" IsVisible="{Binding HasCustomThemeWarning}">
                <TextBlock Text="{Binding CustomThemeWarning}" TextWrapping="Wrap" />
              </Border>
              <ItemsControl ItemsSource="{Binding InstalledThemes}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CustomThemeRow">
                    <Border Classes="tile" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                            <Border Classes="pill" IsVisible="{Binding IsActive}">
                              <TextBlock Text="{l:T theme.custom.active}" />
                            </Border>
                          </StackPanel>
                          <TextBlock Classes="faint" Text="{Binding Author}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                          <Button Classes="ghost" Content="{l:T theme.custom.apply}" Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).ApplyCustomThemeCommand}" CommandParameter="{Binding Id}" />
                          <Button Classes="ghost" Content="{l:T theme.custom.delete}" Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).DeleteCustomThemeCommand}" CommandParameter="{Binding Id}" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <WrapPanel>
                <Button Classes="ghost" Margin="0,0,8,8" Content="{l:T theme.custom.import}" Command="{Binding ImportCustomThemeCommand}" />
                <Button Classes="ghost" Margin="0,0,8,8" Content="{l:T theme.custom.export}" Command="{Binding ExportCustomThemeCommand}" />
              </WrapPanel>
            </StackPanel>
          </Expander>
        </StackPanel>
      </Border>

      <Border Classes="panel">
        <StackPanel Spacing="12">
          <TextBlock Classes="h3" Text="{l:T import.title}" />
          <ToggleSwitch Content="{l:T settings.clipboard}" IsChecked="{Binding SuggestClipboardLinks}" />
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Margin="0,0,18,0">
              <TextBlock Text="{l:T subs.auto}" FontWeight="Medium" TextWrapping="Wrap" />
              <TextBlock Classes="faint" Text="{l:T subs.auto.hint}" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding SubscriptionAutoUpdate}" />
          </Grid>
          <StackPanel Spacing="6" IsVisible="{Binding SubscriptionAutoUpdate}">
            <TextBlock Text="{l:T subs.interval}" />
            <NumericUpDown Value="{Binding SubscriptionUpdateIntervalHours}" Minimum="1" Maximum="168" FormatString="0" Width="140" HorizontalAlignment="Left" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="panel">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="{l:T settings.desktop}" />
          <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding AutostartSupported}">
            <TextBlock Text="{l:T settings.desktop.autostart}" TextWrapping="Wrap" Margin="0,0,18,0" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding StartWithSystem}" />
          </Grid>
          <TextBlock Classes="faint" Text="{l:T settings.desktop.autostart.hint}" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{l:T settings.desktop.connect}" TextWrapping="Wrap" Margin="0,0,18,0" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ConnectOnStartup}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{l:T settings.desktop.tray}" TextWrapping="Wrap" Margin="0,0,18,0" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTray}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{l:T settings.desktop.notifications}" TextWrapping="Wrap" Margin="0,0,18,0" VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowNotifications}" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Connection -->
      <Border Classes="panel">
        <StackPanel Spacing="14">
          <TextBlock Classes="h2" Text="{l:T settings.connection}" />
          <TextBlock Classes="faint" Text="{l:T settings.admin.hint}" TextWrapping="Wrap" />
          <Button Classes="ghost" HorizontalAlignment="Left" Content="{l:T settings.admin.restart}" Command="{Binding RestartElevatedCommand}" IsVisible="{Binding CanRestartElevated}" />
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Margin="0,0,18,0">
              <TextBlock Text="{l:T settings.autoreconnect}" FontWeight="Medium" TextWrapping="Wrap" />
              <TextBlock Classes="faint" Text="{l:T settings.autoreconnect.hint}" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoReconnect}" />
          </Grid>
          <Button Classes="ghost" Content="{l:T settings.killswitch.disable}" Command="{Binding DisableKillSwitchCommand}" IsVisible="{Binding KillSwitch}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>

      <!-- Advanced -->
      <Expander x:Name="AdvancedSettings" Header="{l:T common.advanced}" IsExpanded="{Binding ShowAdvanced, Mode=TwoWay}" HorizontalAlignment="Stretch">
        <StackPanel Spacing="14">
          <v:ActiveConnectionsView DataContext="{Binding Shell.ActiveConnections}" />
          <TextBlock Classes="faint" Text="{l:T settings.associations.hint}" TextWrapping="Wrap" />
          <WrapPanel IsEnabled="{Binding CanRegisterAssociations}">
            <Button Classes="ghost" Content="{l:T settings.associations.register}" Command="{Binding RegisterAssociationsCommand}" Margin="0,0,8,8" />
            <Button Classes="ghost" Content="{l:T settings.associations.remove}" Command="{Binding RemoveAssociationsCommand}" Margin="0,0,0,8" />
          </WrapPanel>
          <StackPanel Spacing="8">
            <StackPanel>
              <TextBlock Text="{l:T settings.check.service}" FontWeight="Medium" />
              <TextBlock Classes="faint" Text="{l:T settings.check.service.hint}" TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.CheckProviders}" SelectedItem="{Binding IpCheckProvider}" MinWidth="180" HorizontalAlignment="Left">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="m:IpCheckProvider">
                  <TextBlock Text="{Binding Converter={x:Static l:PrefixLocConverter.Instance}, ConverterParameter=check.provider.}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <Border Classes="tile">
            <StackPanel Spacing="10">
              <TextBlock Text="{l:T settings.killswitch}" FontWeight="SemiBold" />
              <TextBlock Text="{l:T settings.killswitch.warning}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
              <TextBlock Text="{l:T settings.killswitch.active}" IsVisible="{Binding KillSwitch}" TextWrapping="Wrap" />
              <StackPanel IsVisible="{Binding !KillSwitch}" Spacing="8">
                <CheckBox IsChecked="{Binding KillSwitchAcknowledged}" Content="{l:T settings.killswitch.ack}" />
                <Button Classes="ghost" Content="{l:T settings.killswitch.enable}" Command="{Binding EnableKillSwitchCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Margin="0,0,18,0">
              <TextBlock Text="{l:T settings.port}" FontWeight="Medium" TextWrapping="Wrap" />
              <TextBlock Classes="faint" Text="{l:T settings.port.hint}" TextWrapping="Wrap" />
            </StackPanel>
            <NumericUpDown Grid.Column="1" Value="{Binding LocalPort}" Minimum="1024" Maximum="65535" FormatString="0" Width="140" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Margin="0,0,18,0">
              <TextBlock Text="{l:T settings.sysproxy}" FontWeight="Medium" TextWrapping="Wrap" />
              <TextBlock Classes="faint" Text="{l:T settings.sysproxy.hint}" TextWrapping="Wrap" />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" IsChecked="{Binding SetSystemProxy}" IsEnabled="{Binding SystemProxySupported}" />
          </Grid>

          <Border Classes="tile">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Margin="0,0,18,0">
                  <TextBlock Text="{l:T settings.lan}" FontWeight="Medium" TextWrapping="Wrap" />
                  <TextBlock Classes="faint" Text="{l:T settings.lan.hint}" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AllowLan}" />
              </Grid>
              <StackPanel Spacing="8" IsVisible="{Binding AllowLan}">
                <TextBlock Text="{l:T settings.lan.warning}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
                <TextBlock Classes="caps" Text="{l:T settings.lan.login}" />
                <TextBox Text="{Binding LocalProxyUsername}" Watermark="{l:T settings.lan.login}" MaxLength="64" />
                <TextBlock Classes="caps" Text="{l:T settings.lan.password}" />
                <TextBox Text="{Binding LocalProxyPassword}" PasswordChar="●" Watermark="{l:T settings.lan.password}" MaxLength="128" />
                <TextBlock Classes="faint" Text="{l:T settings.lan.saved}" IsVisible="{Binding HasLocalProxyPassword}" TextWrapping="Wrap" />
                <TextBlock Classes="faint" Text="{l:T settings.lan.nopassword}" IsVisible="{Binding !HasLocalProxyPassword}" TextWrapping="Wrap" />
                <TextBlock Classes="faint" Text="{l:T settings.lan.firewall}" TextWrapping="Wrap" />
                <TextBlock Text="{l:T settings.lan.sysproxy}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" IsVisible="{Binding LanSysProxyConflict}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="tile">
            <StackPanel Spacing="10">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:OutlineIcon Data="{StaticResource LineFlask}" Foreground="{DynamicResource WarningBrush}" />
                <TextBlock Text="{l:T settings.mock}" FontWeight="Medium" TextWrapping="Wrap" />
              </StackPanel>
              <TextBlock Classes="faint" Text="{l:T settings.mock.hint}" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{l:T settings.mock.enable}" VerticalAlignment="Center" />
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding MockMode}" IsEnabled="{Binding !MockForcedByFlag}" />
              </Grid>
              <TextBlock Classes="faint" Text="{l:T settings.mock.forced}" IsVisible="{Binding MockForcedByFlag}" />
              <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.Scenarios}" SelectedItem="{Binding MockScenario}" MinWidth="220">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="m:MockScenario">
                    <TextBlock Text="{Binding Converter={x:Static l:PrefixLocConverter.Instance}, ConverterParameter=mock.}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
          </Border>

          <Border Classes="tile">
            <StackPanel Spacing="6">
              <TextBlock Text="{l:T settings.system}" FontWeight="Medium" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="muted" Text="{l:T settings.admin}" />
                <TextBlock Text="{l:T common.yes}" IsVisible="{Binding IsElevated}" />
                <TextBlock Text="{l:T common.no}" IsVisible="{Binding !IsElevated}" />
              </StackPanel>
              <TextBlock Classes="faint" Text="{l:T settings.admin.hint}" TextWrapping="Wrap" />
              <TextBlock Classes="faint" Text="{l:T settings.admin.manual}" TextWrapping="Wrap" IsVisible="{Binding ShowElevationManualHint}" />
              <TextBlock Text="{l:T helper.title}" FontWeight="Medium" />
              <TextBlock Classes="faint" Text="{l:T helper.hint}" TextWrapping="Wrap" />
              <TextBlock Classes="faint" Text="{l:T helper.unsupported}" IsVisible="{Binding !HelperSupported}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HelperSupported}" IsEnabled="{Binding CanManageHelper}">
                <Button Content="{l:T helper.install}" Command="{Binding InstallHelperCommand}" IsVisible="{Binding !HelperInstalled}" />
                <Button Classes="ghost" Content="{l:T helper.remove}" Command="{Binding RemoveHelperCommand}" IsVisible="{Binding HelperInstalled}" />
              </StackPanel>
              <TextBlock Text="{Binding HelperStatus}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="muted" Text="{l:T settings.secrets}" />
                <TextBlock Text="{Binding SecretProtection}" TextWrapping="Wrap" />
              </StackPanel>
              <SelectableTextBlock Classes="mono" Text="{Binding DataDirectory}" TextWrapping="Wrap" />
              <TextBlock Classes="faint" Foreground="{DynamicResource WarningBrush}" Text="{l:T settings.safelock}" IsVisible="{Binding SafetyLock}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Expander>

      <!-- Backup -->
      <Expander x:Name="BackupSettings" Header="{l:T backup.title}" HorizontalAlignment="Stretch">
        <StackPanel Spacing="12" IsEnabled="{Binding !BackupBusy}">
          <TextBlock Classes="h2" Text="{l:T backup.title}" />
          <TextBlock Classes="faint" Text="{l:T backup.hint}" TextWrapping="Wrap" />
          <TextBox Text="{Binding BackupPassword}" PasswordChar="●" Watermark="{l:T backup.password}" />
          <TextBox Text="{Binding BackupPasswordConfirmation}" PasswordChar="●" Watermark="{l:T backup.password.confirm}" />
          <WrapPanel>
            <Button Classes="ghost" Content="{l:T backup.export}" Command="{Binding ExportBackupCommand}" Margin="0,0,8,8" />
            <Button Classes="ghost" Content="{l:T backup.import}" Command="{Binding OpenBackupCommand}" Margin="0,0,0,8" />
          </WrapPanel>
          <StackPanel IsVisible="{Binding HasBackupPreview}" Spacing="12">
            <TextBlock Classes="h3" Text="{l:T backup.preview}" />
            <ToggleSwitch IsChecked="{Binding BackupReplace}">
              <TextBlock Text="{l:T backup.replace}" TextWrapping="Wrap" />
            </ToggleSwitch>
            <ScrollViewer MaxHeight="300">
              <TextBlock Text="{Binding BackupPreviewText}" TextWrapping="Wrap" />
            </ScrollViewer>
            <WrapPanel>
              <Button Content="{l:T backup.apply}" Command="{Binding ApplyBackupCommand}" Margin="0,0,8,8" />
              <Button Classes="ghost" Content="{l:T backup.cancel}" Command="{Binding CancelBackupCommand}" Margin="0,0,0,8" />
            </WrapPanel>
          </StackPanel>
        </StackPanel>
      </Expander>

      <!-- About & credits -->
      <Expander Header="{l:T settings.about}" HorizontalAlignment="Stretch">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Image Source="{StaticResource BrandLogo}" Width="38" Height="38" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Version, StringFormat='BYDLO {0}'}" FontWeight="Bold" />
              <TextBlock Classes="faint" Text="{l:T app.full}" />
            </StackPanel>
          </StackPanel>
          <TextBlock Classes="muted" Text="{l:T about.text}" TextWrapping="Wrap" />
          <Border Classes="tile">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Margin="0,0,18,0">
                  <TextBlock Text="{l:T settings.update.auto}" FontWeight="Medium" TextWrapping="Wrap" />
                  <TextBlock Classes="faint" Text="{l:T settings.update.auto.hint}" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding CheckForUpdates}" />
              </Grid>
              <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap" />
              <WrapPanel>
                <Button Classes="ghost" Content="{l:T settings.update.check}" Command="{Binding CheckUpdatesCommand}" Margin="0,0,8,0" IsEnabled="{Binding !IsCheckingUpdates}" />
                <Button Classes="ghost" Content="{l:T settings.update.open}" Command="{Binding OpenUrlCommand}" CommandParameter="{Binding UpdateUrl}" IsVisible="{Binding HasUpdateUrl}" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <TextBlock Classes="caps" Text="{l:T about.credits}" Margin="0,6,0,0" />
          <ItemsControl ItemsSource="{x:Static vm:SettingsViewModel.Credits}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:Credit">
                <Border Classes="tile" Margin="0,0,0,6">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="1">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                        <TextBlock Classes="faint" Text="{Binding Author}" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Classes="faint" Text="{Binding LocalizedRole}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Border Classes="pill"><TextBlock Text="{Binding License}" /></Border>
                      <Button Classes="icon" ToolTip.Tip="{Binding Url}"
                              Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).OpenUrlCommand}" CommandParameter="{Binding Url}">
                        <c:OutlineIcon Data="{StaticResource LineLink}" Width="15" Height="15" />
                      </Button>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Expander>
    </StackPanel>
  </ScrollViewer>
</UserControl>
