<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="using:Bydlo.App.Controls"
             xmlns:vm="using:Bydlo.App.ViewModels"
             xmlns:l="using:Bydlo.App.Services"
             x:Class="Bydlo.App.Views.ConnectionsView"
             x:DataType="vm:ConnectionsViewModel">
  <UserControl.Styles>
    <Style Selector="Grid.connection-library">
      <Setter Property="MaxWidth" Value="1016" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Margin" Value="20,24,20,0" />
    </Style>
    <Style Selector=".desktop Grid.connection-library">
      <Setter Property="Margin" Value="32,28,32,0" />
    </Style>
    <Style Selector="TabItem /template/ Border#PART_SelectedPipe">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Border.profile-row > Grid">
      <Setter Property="Margin" Value="12,0" />
    </Style>
    <Style Selector="Border.library-empty">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
      <Setter Property="Padding" Value="16" />
    </Style>
  </UserControl.Styles>
  <Border>
    <Grid Classes="connection-library" RowDefinitions="Auto,Auto,*" RowSpacing="12">
      <Border Classes="page-heading">
        <StackPanel Spacing="8">
          <TextBlock Classes="h1" Text="{l:T nav.connections}" />
          <TextBlock Classes="muted" Text="{l:T connections.subtitle}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <WrapPanel Grid.Row="1">
        <Button Classes="primary" Margin="0,0,8,8" Command="{Binding Shell.OpenAddServerCommand}" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <c:OutlineIcon Data="{StaticResource LinePlus}" Foreground="{DynamicResource OnPrimaryBrush}" />
            <TextBlock Text="{l:T wizard.title}" Foreground="{DynamicResource OnPrimaryBrush}" />
          </StackPanel>
        </Button>
        <Button Classes="ghost" Margin="0,0,8,8" Content="{l:T catalog.title}" Command="{Binding Shell.OpenImportCommand}" CommandParameter="catalog" />
        <Button Classes="ghost" Margin="0,0,0,8" Content="{l:T import.demo}" Command="{Binding AddDemoProfilesCommand}" IsVisible="{Binding Shell.IsMock}" />
      </WrapPanel>

      <TabControl Grid.Row="2" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
      <TabItem Padding="8,6" MinWidth="0" AutomationProperties.Name="{l:T connections.profiles}">
      <TabItem.Header><TextBlock Text="{l:T connections.profiles}" FontSize="13" FontWeight="Medium" /></TabItem.Header>
      <ScrollViewer Padding="0,12,0,12">
      <StackPanel Spacing="12">
      <StackPanel Spacing="10">
        <TextBox Text="{Binding ProfileSearch}" IsVisible="{Binding !IsEmpty}"
                 Watermark="{l:T connections.search}" AutomationProperties.Name="{l:T connections.search}" />
        <WrapPanel IsVisible="{Binding !IsEmpty}">
          <Button Classes="ghost" Margin="0,0,8,6" Content="{l:T connections.latency.check}" Command="{Binding CheckLatencyCommand}" IsEnabled="{Binding CanCheckLatency}" />
          <CheckBox Margin="0,0,8,6" Content="{l:T connections.latency.sort}" IsChecked="{Binding Shell.SortByLatency}" />
          <CheckBox Margin="0,0,0,6" Content="{l:T connections.filter.working}" IsChecked="{Binding OnlyWorking}" />
        </WrapPanel>
        <TextBlock Classes="faint" Text="{Binding CheckLatencyDisabledReason}" IsVisible="{Binding CheckLatencyDisabledReason, Converter={x:Static ObjectConverters.IsNotNull}}" TextWrapping="Wrap" />
        <TextBlock Classes="muted" Text="{l:T connections.search.empty}" IsVisible="{Binding HasNoMatchingProfiles}" TextWrapping="Wrap" />
        <Border Classes="library-empty" IsVisible="{Binding IsEmpty}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <c:OutlineIcon Data="{StaticResource LineServers}" Width="22" Height="22" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Grid.Column="1" Classes="muted" Text="{l:T connections.empty}" VerticalAlignment="Center" TextWrapping="Wrap" />
          </Grid>
        </Border>
        <Border Classes="panel" Padding="0" IsVisible="{Binding !IsEmpty}">
        <ItemsControl ItemsSource="{Binding VisibleProfiles}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProfileItem">
              <Border Classes="row profile-row" Classes.active="{Binding IsActive}">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Classes.reflow="{Binding $parent[UserControl].((vm:ConnectionsViewModel)DataContext).Shell.IsCompact}">
                  <Border Width="34" Height="34" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource Surface2Brush}">
                    <c:OutlineIcon Data="{StaticResource LineShield}" Foreground="{DynamicResource AccentBrush}" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="faint" Text="{Binding MeasuredSpeedText}" IsVisible="{Binding HasMeasuredSpeed}"
                                 ToolTip.Tip="{l:T connections.speed.title}" />
                      <Border Classes="pill ok" HorizontalAlignment="Left" Padding="7,1" IsVisible="{Binding IsActive}">
                        <TextBlock Text="{l:T status.connected}" FontSize="10" />
                      </Border>
                    </StackPanel>
                    <TextBlock Classes="faint" Text="{Binding Details}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Classes="faint" Text="{Binding Endpoint}" TextTrimming="CharacterEllipsis" />
                      <Border Classes="pill" Classes.ok="{Binding LatencyOk}" Classes.warn="{Binding LatencyWarn}" Classes.bad="{Binding LatencyBad}"
                              IsVisible="{Binding HasLatency}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LatencyText}" FontSize="10" />
                      </Border>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Classes="profile-actions" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="icon" Content="⋯" AutomationProperties.Name="{l:T connections.actions}" ToolTip.Tip="{l:T connections.actions}">
                      <Button.Flyout>
                        <Flyout>
                          <StackPanel Spacing="6">
                            <Button Content="{l:T profile.edit.title}"
                                    Command="{Binding $parent[UserControl].((vm:ConnectionsViewModel)DataContext).EditProfileCommand}" CommandParameter="{Binding}" />
                            <Button Content="{l:T profile.edit.duplicate}"
                                    Command="{Binding $parent[UserControl].((vm:ConnectionsViewModel)DataContext).DuplicateProfileCommand}" CommandParameter="{Binding}" />
                            <Button Content="{l:T share.qr}" IsVisible="{Binding CanShareLink}"
                                    Command="{Binding $parent[UserControl].((vm:ConnectionsViewModel)DataContext).ShowQrCommand}" CommandParameter="{Binding}" />
                            <Button Content="{l:T share.copy}" IsVisible="{Binding CanShareLink}"
                                    Command="{Binding $parent[UserControl].((vm:ConnectionsViewModel)DataContext).CopyLinkCommand}" CommandParameter="{Binding}" />
                            <Button Content="{l:T share.file}" IsVisible="{Binding CanExportConfig}"
                                    Command="{Binding $parent[UserControl].((vm:ConnectionsViewModel)DataContext).ExportConfigCommand}" CommandParameter="{Binding}" />
                          </StackPanel>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                    <Button Classes="icon" AutomationProperties.Name="{l:T connections.favorite}" ToolTip.Tip="{l:T connections.favorite}"
                            Command="{Binding $parent[UserControl].((vm:ConnectionsViewModel)DataContext).ToggleFavoriteCommand}" CommandParameter="{Binding}">
                      <Panel>
                        <c:OutlineIcon Data="{StaticResource LineStar}" Width="16" Height="16" IsVisible="{Binding IsFavorite}" Foreground="{DynamicResource WarningBrush}" />
                        <c:OutlineIcon Data="{StaticResource LineStar}" Width="16" Height="16" IsVisible="{Binding !IsFavorite}" Opacity="0.4" />
                      </Panel>
                    </Button>
                    <Button Classes="icon" AutomationProperties.Name="{l:T connections.delete}" ToolTip.Tip="{l:T connections.delete}">
                      <c:OutlineIcon Data="{StaticResource LineDelete}" Width="16" Height="16" />
                      <Button.Flyout>
                        <Flyout>
                          <StackPanel Spacing="10" MaxWidth="240">
                            <TextBlock Text="{l:T connections.delete.confirm}" TextWrapping="Wrap" />
                            <Button Classes="danger" Content="{l:T connections.delete}"
                                    Command="{Binding $parent[UserControl].((vm:ConnectionsViewModel)DataContext).DeleteCommand}" CommandParameter="{Binding}" />
                          </StackPanel>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                    <Button Content="{l:T home.connect}" Classes="ghost" Margin="6,0,0,0" Padding="10,8"
                            Command="{Binding $parent[UserControl].((vm:ConnectionsViewModel)DataContext).ConnectToCommand}" CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </Border>
      </StackPanel>

      <Expander Header="{l:T connections.speed.title}" IsVisible="{Binding !IsEmpty}" HorizontalAlignment="Stretch">
        <StackPanel Spacing="8">
          <TextBlock Text="{l:T connections.speed.notice}" Classes="faint" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SpeedTestDisabledReason}" Classes="faint" TextWrapping="Wrap"
                     IsVisible="{Binding SpeedTestDisabledReason, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBox Watermark="{l:T connections.speed.url}" Text="{Binding SpeedTestUrl}" />
          <WrapPanel>
            <Button Content="{l:T connections.speed.start}" Command="{Binding MeasureSpeedCommand}"
                    IsEnabled="{Binding CanMeasureSpeed}" />
            <Button Content="{l:T connections.speed.cancel}" Command="{Binding MeasureSpeedCancelCommand}"
                    IsVisible="{Binding MeasuringSpeed}" />
          </WrapPanel>
          <CheckBox Content="{l:T connections.speed.sort}" IsChecked="{Binding Shell.SortBySpeed}" />
        </StackPanel>
      </Expander>
      <TextBlock Classes="faint" Text="{l:T connections.latency.udp}" TextWrapping="Wrap" IsVisible="{Binding !IsEmpty}" />
      <Expander Header="{l:T warp.title}" HorizontalAlignment="Stretch">
        <StackPanel Spacing="8">
          <TextBlock Classes="muted" Text="{l:T warp.hint}" TextWrapping="Wrap" />
          <TextBlock Classes="faint" Text="{l:T warp.consent}" TextWrapping="Wrap" />
          <Button Classes="ghost" Content="{l:T warp.register}" Command="{Binding RegisterWarpCommand}" IsEnabled="{Binding CanRegisterWarp}" HorizontalAlignment="Left"
                  IsVisible="{Binding !IsWarpBusy}" />
          <Button Classes="ghost" Content="{l:T warp.registering}" HorizontalAlignment="Left" IsEnabled="False" IsVisible="{Binding IsWarpBusy}" />
          <ProgressBar IsIndeterminate="{Binding IsWarpBusy}" IsVisible="{Binding IsWarpBusy}" Height="3" />
        </StackPanel>
      </Expander>
      </StackPanel>
      </ScrollViewer>
      </TabItem>

      <!-- Proxy chains -->
      <TabItem Padding="8,6" MinWidth="0" AutomationProperties.Name="{l:T chain.title}">
      <TabItem.Header><TextBlock Text="{l:T chain.title}" FontSize="13" FontWeight="Medium" /></TabItem.Header>
      <ScrollViewer Padding="0,12,0,12">
      <StackPanel Spacing="10">
        <TextBlock Classes="faint" Text="{l:T chain.hint}" TextWrapping="Wrap" />
        <Button Classes="ghost" Content="{l:T chain.new}" Command="{Binding Shell.NewChainCommand}" HorizontalAlignment="Left" />
        <Border Classes="library-empty" IsVisible="{Binding Shell.HasNoChains}">
          <TextBlock Classes="muted" Text="{l:T chain.empty}" TextWrapping="Wrap" />
        </Border>
        <Border Classes="panel" Padding="0" IsVisible="{Binding Shell.HasChains}">
        <ItemsControl ItemsSource="{Binding Shell.Chains}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChainItem">
              <Border Classes="row profile-row" Classes.active="{Binding IsActive}">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Classes.reflow="{Binding $parent[UserControl].((vm:ConnectionsViewModel)DataContext).Shell.IsCompact}">
                  <Border Width="34" Height="34" CornerRadius="{DynamicResource RadiusSmall}" Background="{DynamicResource Surface2Brush}">
                    <c:OutlineIcon Data="{StaticResource LineLink}" Foreground="{DynamicResource AccentBrush}" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                      <Border Classes="pill ok" HorizontalAlignment="Left" Padding="7,1" IsVisible="{Binding IsActive}">
                        <TextBlock Text="{l:T status.connected}" FontSize="10" />
                      </Border>
                    </StackPanel>
                    <TextBlock Classes="faint" Text="{Binding Details}" />
                    <TextBlock Classes="faint" Text="{Binding HopSummary}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Classes="profile-actions" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="icon" AutomationProperties.Name="{l:T connections.favorite}" ToolTip.Tip="{l:T connections.favorite}"
                            Command="{Binding $parent[UserControl].((vm:ConnectionsViewModel)DataContext).ToggleChainFavoriteCommand}" CommandParameter="{Binding}">
                      <Panel>
                        <c:OutlineIcon Data="{StaticResource LineStar}" Width="16" Height="16" IsVisible="{Binding IsFavorite}" Foreground="{DynamicResource WarningBrush}" />
                        <c:OutlineIcon Data="{StaticResource LineStar}" Width="16" Height="16" IsVisible="{Binding !IsFavorite}" Opacity="0.4" />
                      </Panel>
                    </Button>
                    <Button Classes="icon" AutomationProperties.Name="{l:T chain.edit}" ToolTip.Tip="{l:T chain.edit}"
                            Command="{Binding $parent[UserControl].((vm:ConnectionsViewModel)DataContext).EditChainCommand}" CommandParameter="{Binding}">
                      <c:OutlineIcon Data="{StaticResource LinePencil}" Width="16" Height="16" />
                    </Button>
                    <Button Classes="icon" AutomationProperties.Name="{l:T chain.delete}" ToolTip.Tip="{l:T chain.delete}">
                      <c:OutlineIcon Data="{StaticResource LineDelete}" Width="16" Height="16" />
                      <Button.Flyout>
                        <Flyout>
                          <StackPanel Spacing="10" MaxWidth="240">
                            <TextBlock Text="{l:T chain.delete.confirm}" TextWrapping="Wrap" />
                            <Button Classes="danger" Content="{l:T chain.delete}"
                                    Command="{Binding $parent[UserControl].((vm:ConnectionsViewModel)DataContext).DeleteChainCommand}" CommandParameter="{Binding}" />
                          </StackPanel>
                        </Flyout>
                      </Button.Flyout>
                    </Button>
                    <Button Content="{l:T home.connect}" Classes="ghost" Margin="6,0,0,0" Padding="10,8"
                            Command="{Binding $parent[UserControl].((vm:ConnectionsViewModel)DataContext).ConnectChainCommand}" CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        </Border>
      </StackPanel>
      </ScrollViewer>
      </TabItem>

      <!-- Subscriptions -->
      <TabItem Padding="8,6" MinWidth="0" AutomationProperties.Name="{l:T subs.title}">
      <TabItem.Header><TextBlock Text="{l:T subs.title}" FontSize="13" FontWeight="Medium" /></TabItem.Header>
      <ScrollViewer Padding="0,12,0,12">
        <StackPanel Spacing="12">
          <Button Classes="ghost" Content="{l:T import.link.title}" Command="{Binding Shell.OpenImportCommand}" CommandParameter="link" />
          <Border Classes="library-empty" IsVisible="{Binding !Subscriptions.Count}">
            <TextBlock Classes="muted" Text="{l:T subs.empty}" TextWrapping="Wrap" />
          </Border>
          <TextBlock Classes="faint" Text="{l:T subs.hint}" TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Subscriptions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SubscriptionRow">
                <Border Classes="tile" Margin="0,0,0,6">
                  <StackPanel Spacing="6">
                    <StackPanel Spacing="6">
                      <TextBox Text="{Binding Name}" VerticalAlignment="Center" AutomationProperties.Name="{l:T subs.rename}" />
                      <WrapPanel>
                        <Button Classes="ghost" Content="{l:T subs.rename}" ToolTip.Tip="{l:T subs.rename}"
                                Command="{Binding $parent[UserControl].((vm:ConnectionsViewModel)DataContext).RenameSubscriptionCommand}" CommandParameter="{Binding}" />
                        <Button Classes="icon" ToolTip.Tip="{l:T subs.refresh}" AutomationProperties.Name="{l:T subs.refresh}"
                                Command="{Binding $parent[UserControl].((vm:ConnectionsViewModel)DataContext).RefreshSubscriptionCommand}" CommandParameter="{Binding}">
                          <c:OutlineIcon Data="{StaticResource LineRefresh}" Width="16" Height="16" />
                        </Button>
                        <Button Classes="icon" ToolTip.Tip="{l:T subs.delete}" AutomationProperties.Name="{l:T subs.delete}">
                          <c:OutlineIcon Data="{StaticResource LineDelete}" Width="16" Height="16" />
                          <Button.Flyout>
                            <Flyout>
                              <StackPanel Spacing="10" MaxWidth="240">
                                <TextBlock Text="{l:T subs.delete.confirm}" TextWrapping="Wrap" />
                                <Button Classes="danger" Content="{l:T subs.delete}"
                                        Command="{Binding $parent[UserControl].((vm:ConnectionsViewModel)DataContext).DeleteSubscriptionCommand}" CommandParameter="{Binding}" />
                              </StackPanel>
                            </Flyout>
                          </Button.Flyout>
                        </Button>
                      </WrapPanel>
                    </StackPanel>
                    <TextBox Text="{Binding UserAgent}" Watermark="{l:T subs.useragent}" AutomationProperties.Name="{l:T subs.useragent}" />
                    <WrapPanel>
                      <Button Classes="ghost" Content="{l:T subs.useragent.save}" ToolTip.Tip="{l:T subs.useragent.hint}"
                              Command="{Binding $parent[UserControl].((vm:ConnectionsViewModel)DataContext).SaveSubscriptionUserAgentCommand}" CommandParameter="{Binding}" />
                    </WrapPanel>
                    <TextBlock Classes="faint" Text="{Binding Details}" TextWrapping="Wrap" IsVisible="{Binding HasDetails}" />
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding TrafficFraction}" IsVisible="{Binding HasTraffic}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <TextBlock Classes="faint" Text="{Binding ModeLabel}" VerticalAlignment="Center" />
                      <Button Classes="ghost" Content="{l:T subs.mode.toggle}" ToolTip.Tip="{l:T subs.mode.toggle}"
                              Command="{Binding $parent[UserControl].((vm:ConnectionsViewModel)DataContext).ToggleSubscriptionModeCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                    <TextBlock Classes="faint" Text="{Binding LastUpdated, StringFormat='{}{0:g}'}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
      </TabItem>
      </TabControl>
    </Grid>
  </Border>
</UserControl>
