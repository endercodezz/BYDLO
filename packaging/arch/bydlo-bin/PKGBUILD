# Maintainer: Dmitri Shimanski <dshiafeed at gmail dot com>
# Prebuilt BYDLO from the official GitHub release (self-contained, with pinned engines).
# Update: bump pkgver, then `updpkgsums` and `makepkg --printsrcinfo > .SRCINFO`.
pkgname=bydlo-bin
pkgver=0.4.3
pkgrel=1
pkgdesc='Bypass Your Digital Limitations Online — one app for every protocol'
arch=('x86_64' 'aarch64')
url='https://github.com/endercodezz/BYDLO'
license=('GPL-3.0-or-later')
# Self-contained .NET still loads ICU and OpenSSL; Avalonia needs X11 and fontconfig.
depends=('glibc' 'gcc-libs' 'zlib' 'icu' 'openssl' 'fontconfig' 'freetype2'
         'libx11' 'libice' 'libsm' 'libxcursor' 'libxext' 'libxi' 'libxrandr')
optdepends=('libsecret: store profile secrets in the Secret Service keyring'
            'libnotify: desktop notifications'
            'wireguard-tools: WireGuard profiles')
provides=('bydlo')
conflicts=('bydlo' 'bydlo-git')
# The single-file .NET bundle must not be stripped: that corrupts the embedded payload.
options=('!strip' '!debug')
# The .deb is only read as an archive; no dpkg install or maintainer script runs.
source_x86_64=("${url}/releases/download/v${pkgver}/bydlo_${pkgver}_amd64.deb")
source_aarch64=("${url}/releases/download/v${pkgver}/bydlo_${pkgver}_arm64.deb")
noextract=("bydlo_${pkgver}_amd64.deb" "bydlo_${pkgver}_arm64.deb")
sha256sums_x86_64=('334b8bcd940ba734d4c78b41b1f6e766585edfd7652bcb61793fab07a3a1a7ed')
sha256sums_aarch64=('87461e00d99e379e0e2c3206ef6e8887c93cf53c60872762f43b35f43bdbdb70')

prepare() {
  local deb_arch=amd64
  [[ $CARCH == aarch64 ]] && deb_arch=arm64
  mkdir -p bydlo
  bsdtar -xf "bydlo_${pkgver}_${deb_arch}.deb" data.tar.xz
  bsdtar -xf data.tar.xz -C bydlo
}
package() {
  install -dm755 "$pkgdir/opt/bydlo"
  cp -a bydlo/opt/bydlo/. "$pkgdir/opt/bydlo/"
  find "$pkgdir/opt/bydlo" -type f \( -name BYDLO -o -name Bydlo.Helper -o -name nfqws -o -name tpws -o -name sing-box \
    -o -name xray -o -name bydlo-amneziawg -o -name openvpn \) -exec chmod 755 {} +

  # BYDLO_LAUNCHER keeps autostart / import associations on this stable path.
  install -dm755 "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/bydlo" <<'EOF'
#!/bin/sh
export BYDLO_LAUNCHER="${BYDLO_LAUNCHER:-/usr/bin/bydlo}"
exec /opt/bydlo/BYDLO "$@"
EOF
  chmod 755 "$pkgdir/usr/bin/bydlo"

  install -dm755 "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/bydlo.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=BYDLO
GenericName=Bypass Your Digital Limitations Online
Comment=One app. Every protocol.
Exec=bydlo
Icon=bydlo
Terminal=false
Categories=Network;Utility;
StartupWMClass=BYDLO
EOF
  chmod 644 "$pkgdir/usr/share/applications/bydlo.desktop"
  install -Dm644 "bydlo/usr/share/icons/hicolor/256x256/apps/bydlo.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/bydlo.png"
  install -Dm644 bydlo/opt/bydlo/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 bydlo/opt/bydlo/THIRD_PARTY_NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
}
